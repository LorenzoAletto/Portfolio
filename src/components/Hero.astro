---
// Hero.astro
---

<section id="hero" class="w-full min-h-[95vh] flex items-center justify-center px-6">
  <div class="flex flex-col items-center w-full">
    <div 
      id="profile-container" 
      class="profile-container cursor-pointer select-none group w-full"
      role="button"
      aria-expanded="false"
      tabindex="0"
    >
      <!-- Avatar Image wrapper -->
      <div class="profile-img-wrapper group-hover:scale-102 transition-transform duration-300">
        <img 
          src="/Lorenzo_superDeveloper.jpeg" 
          alt="Lorenzo Aletto" 
          class="w-full h-full object-cover"
          loading="eager"
        />
        <!-- Ping notification dot -->
        <span id="ping-dot" class="absolute -top-1 -right-1 flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-text-primary/40 dark:bg-text-dark/40"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-text-primary/60 dark:bg-text-dark/60"></span>
        </span>
      </div>

      <!-- Text info container -->
      <div class="profile-info">
        <h1 class="profile-title tracking-tight text-text-primary dark:text-text-dark">
          Lorenzo Aletto
          <span id="hero-hint-icon" class="inline-block opacity-0 group-hover:opacity-40 transition-opacity duration-500 text-2xl md:text-3xl ml-1">↗</span>
        </h1>
        <p 
          id="profile-desc"
          class="profile-desc text-text-primary/80 dark:text-text-dark/80 text-base md:text-lg leading-relaxed max-w-xl font-light"
        >
          <!-- The typewriter animation will populate this text -->
        </p>
      </div>
    </div>

    <!-- Social Links -->
    <div id="social-links" class="flex items-center justify-center gap-4 mt-8">
      <a href="mailto:lorenzoaletto28@gmail.com?subject=Contacto%20desde%20portafolio&body=Hola%20Lorenzo%2C%20vi%20tu%20portafolio%20y%20quiero%20conversar%20contigo." class="social-btn" aria-label="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
      <a href="https://github.com/lorenzoaletto" target="_blank" class="social-btn" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/lorenzo-aletto-732330303/" target="_blank" class="social-btn" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  const profileContainer = document.getElementById('profile-container')!;
  const profileDesc = document.getElementById('profile-desc')!;
  const socialLinks = document.getElementById('social-links')!;
  const pingDot = document.getElementById('ping-dot')!;
  const hintIcon = document.getElementById('hero-hint-icon')!;
  
  let isExpanded = false;
  let typingInterval: number | null = null;
  let transitionTimeout: number | null = null;

  function getTranslation(key: string, lang: 'es' | 'en'): string {
    return (window as any).translations?.[lang]?.[key] || '';
  }

  function getCurrentLang(): 'es' | 'en' {
    return (localStorage.getItem('lang') || 'es') as 'es' | 'en';
  }

  // Typewriter effect
  function startTypewriter(text: string, speed: number) {
    if (typingInterval) {
      clearInterval(typingInterval);
      typingInterval = null;
    }
    
    profileDesc.textContent = '';
    let charIndex = 0;
    
    typingInterval = window.setInterval(() => {
      if (charIndex < text.length) {
        profileDesc.textContent += text.charAt(charIndex);
        charIndex++;
      } else {
        if (typingInterval) {
          clearInterval(typingInterval);
          typingInterval = null;
        }
      }
    }, speed);
  }

  // Click handler (Expanded state is locked once activated)
  profileContainer.addEventListener('click', () => {
    if (isExpanded) return; // Locked once expanded!

    isExpanded = true;
    profileContainer.classList.add('expanded');
    profileContainer.setAttribute('aria-expanded', 'true');
    socialLinks.classList.add('social-links-expanded');
    pingDot.classList.add('opacity-0');
    hintIcon.style.opacity = '0';

    // Remove cursor pointer and hover scales since it can no longer be clicked
    profileContainer.classList.remove('cursor-pointer');
    
    if (transitionTimeout) {
      clearTimeout(transitionTimeout);
      transitionTimeout = null;
    }
    if (typingInterval) {
      clearInterval(typingInterval);
      typingInterval = null;
    }

    profileDesc.textContent = '';
    
    // Wait for layout transition (900ms) to complete before typing
    transitionTimeout = window.setTimeout(() => {
      const lang = getCurrentLang();
      const text = getTranslation('hero.desc', lang);
      startTypewriter(text, 12);
    }, 900);
  });

  // Support pressing Enter or Space to toggle when focused
  profileContainer.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      profileContainer.click();
    }
  });

  // Listen for language change to update text dynamically
  window.addEventListener('lang-change', (e: any) => {
    if (isExpanded) {
      const newLang = e.detail.lang;
      const text = getTranslation('hero.desc', newLang);
      
      if (typingInterval) {
        startTypewriter(text, 12);
      } else {
        profileDesc.textContent = text;
      }
    } else {
      profileDesc.textContent = '';
    }
  });
</script>
