---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Lorenzo Aletto | Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Outfit Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <script is:inline>
      // Theme initialization (FOUC prevention)
      (function () {
        const theme = localStorage.getItem('theme') || 'system';
        if (
          theme === 'dark' || 
          (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        document.documentElement.dataset.theme = theme;
      })();

      // Language initialization
      (function () {
        const lang = localStorage.getItem('lang') || 'es';
        document.documentElement.setAttribute('lang', lang);
      })();
    </script>
  </head>
  <body class="bg-bg-primary text-text-primary dark:bg-bg-dark dark:text-text-dark transition-colors duration-500 font-sans min-h-screen flex flex-col antialiased">
    <slot />

    <script>
      // Add translations directly to window object for runtime updates
      (window as any).translations = {
        es: {
          "nav.projects": "Proyectos",
          "nav.contact": "Contacto",
          "theme.system": "System",
          "theme.dark": "Oscuro",
          "theme.light": "Claro",
          "lang.es": "Español",
          "lang.en": "Inglés",
          "hero.title": "Lorenzo Aletto",
          "hero.desc": "Hola, soy Lorenzo Aletto. Desarrollador Full Stack con pasión por construir experiencias digitales que combinan funcionalidad, rendimiento y un diseño atractivo. Me gusta transformar ideas en aplicaciones web intuitivas y escalables, siempre buscando aprender nuevas tecnologías y mejorar mis habilidades. También me interesa el desarrollo de videojuegos, donde puedo unir creatividad y programación para crear experiencias interactivas.",
          "education.title": "Educación",
          "education.degree": "Técnico universitario en programación",
          "education.university": "Universidad Tecnológica Nacional de Mar del plata",
          "education.date": "feb 2022 - dic 2025",
          "tech.title": "Tecnologías",
          "projects.title": "Mis Proyectos",
          "projects.desc": "Una muestra de algunos desarrollos recientes enfocados en performance, interactividad y diseño moderno.",
          "projects.card1.title": "Plataforma de E-Learning",
          "projects.card1.desc": "Una plataforma educativa interactiva con dashboards y seguimiento de progreso.",
          "projects.card2.title": "Dashboard Financiero",
          "projects.card2.desc": "Visualizador de analíticas financieras en tiempo real con gráficos interactivos.",
          "projects.card3.title": "Aplicación de Reservas",
          "projects.card3.desc": "Sistema de agenda y reserva de turnos en tiempo real con notificaciones.",
          "contact.title": "Contacto",
          "contact.desc": "¿Tenes un proyecto en mente o queres conversar? Sentite libre de escribirme y te respondo lo antes posible.",
          "contact.info": "Información de Contacto",
          "contact.form.name": "Nombre",
          "contact.form.email": "Correo",
          "contact.form.message": "Mensaje",
          "contact.form.send": "Enviar Mensaje"
        },
        en: {
          "nav.projects": "Projects",
          "nav.contact": "Contact",
          "theme.system": "System",
          "theme.dark": "Dark",
          "theme.light": "Light",
          "lang.es": "Spanish",
          "lang.en": "English",
          "hero.title": "Lorenzo Aletto",
          "hero.desc": "Hi, I'm Lorenzo Aletto. A Full Stack Developer passionate about turning ideas into modern, scalable, and interactive digital experiences. I enjoy blending clean code with thoughtful design to build intuitive web applications that are both functional and engaging. Beyond web development, I'm deeply interested in game development, where I can combine creativity and technology to create immersive interactive worlds.",
          "education.title": "Education",
          "education.degree": "University Technician in Programming",
          "education.university": "Universidad Tecnológica Nacional de Mar del plata",
          "education.date": "feb 2022 - dec 2025",
          "tech.title": "Technologies",
          "projects.title": "My Projects",
          "projects.desc": "A sample of some recent developments focusing on performance, interactivity, and modern design.",
          "projects.card1.title": "E-Learning Platform",
          "projects.card1.desc": "An interactive educational platform with dashboards and progress tracking.",
          "projects.card2.title": "Financial Dashboard",
          "projects.card2.desc": "Real-time financial analytics visualizer with interactive charts.",
          "projects.card3.title": "Booking Application",
          "projects.card3.desc": "Real-time scheduling and booking system with automated alerts.",
          "contact.title": "Contact",
          "contact.desc": "Have a project in mind or want to chat? Feel free to reach out, and I'll get back to you as soon as possible.",
          "contact.info": "Contact Information",
          "contact.form.name": "Name",
          "contact.form.email": "Email",
          "contact.form.message": "Message",
          "contact.form.send": "Send Message"
        }
      };

      (window as any).updateTranslations = function(lang: 'es' | 'en') {
        document.documentElement.setAttribute('lang', lang);
        localStorage.setItem('lang', lang);
        
        // Dispatch custom event to notify components
        window.dispatchEvent(new CustomEvent('lang-change', { detail: { lang } }));
        
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (key && (window as any).translations[lang] && (window as any).translations[lang][key]) {
            el.textContent = (window as any).translations[lang][key];
          }
        });

        document.querySelectorAll('[data-i18n-es][data-i18n-en]').forEach(el => {
          const val = lang === 'es' ? el.getAttribute('data-i18n-es') : el.getAttribute('data-i18n-en');
          if (val) {
            el.textContent = val;
          }
        });

        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (key && (window as any).translations[lang] && (window as any).translations[lang][key]) {
            el.setAttribute('placeholder', (window as any).translations[lang][key]);
          }
        });
      };

      // Set initial translation
      const lang = (localStorage.getItem('lang') || 'es') as 'es' | 'en';
      (window as any).updateTranslations(lang);
    </script>
  </body>
</html>
