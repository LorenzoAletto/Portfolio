---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import projects from "../data/projects.json";
import technologies from "../data/technologies.json";
---

<Layout title="Lorenzo Aletto | Portfolio">
  <!-- Header -->
  <Header />

  <!-- Hero Section (full viewport) -->
  <Hero />

  <!-- Main Content wrapper -->
  <main class="grow max-w-6xl mx-auto w-full px-6 md:px-12">
    <!-- Projects Section -->
    <section id="projects" class="py-20 border-t border-text-primary/5 dark:border-text-dark/5 scroll-mt-24">
      <div class="reveal-item max-w-3xl mx-auto mb-16 text-center">
        <h2 
          class="text-3xl md:text-4xl font-extrabold mb-4 tracking-tight text-text-primary dark:text-text-dark"
          data-i18n="projects.title"
        >
          Mis Proyectos
        </h2>
        <p 
          class="text-text-primary/70 dark:text-text-dark/70 text-lg leading-relaxed font-light"
          data-i18n="projects.desc"
        >
          Una muestra de algunos desarrollos recientes enfocados en performance, interactividad y diseño moderno.
        </p>
      </div>

      <!-- Alternating Projects List -->
      <div class="flex flex-col gap-24 md:gap-32">
        {projects.map((project, index) => (
          <div 
            class={`reveal-item group flex flex-col md:flex-row gap-8 md:gap-16 items-center ${
              index % 2 === 1 ? 'md:flex-row-reverse' : ''
            }`}
          >
            <!-- Project Image container (clickable for video demo) -->
            <div 
              class="project-image-wrapper relative w-full md:w-1/2 overflow-hidden rounded-2xl border border-text-primary/10 dark:border-text-dark/10 shadow-md hover:shadow-xl transition-all duration-500 bg-white/40 dark:bg-white/5 backdrop-blur-sm p-3 group-hover:scale-[1.01] cursor-pointer"
              data-video={project.video}
              data-title={project.titleEs}
            >
              <img 
                src={project.image} 
                alt={project.titleEs} 
                class="w-full h-auto object-cover rounded-xl transition-transform duration-700 group-hover:scale-102"
                loading="lazy"
              />
            </div>

            <!-- Project Details container -->
            <div class="w-full md:w-1/2 flex flex-col justify-center">
              <!-- Tech tags -->
              <div class="flex flex-wrap gap-2 mb-4">
                {project.tech.map((tech) => (
                  <span class="bg-text-primary/5 dark:bg-text-dark/5 text-text-primary/80 dark:text-text-dark/80 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Title -->
              <h3 
                class="text-2xl md:text-3xl font-extrabold mb-3 text-text-primary dark:text-text-dark tracking-tight"
                data-i18n-es={project.titleEs}
                data-i18n-en={project.titleEn}
              >
                {project.titleEs}
              </h3>

              <!-- Description -->
              <p 
                class="text-text-primary/80 dark:text-text-dark/80 text-base md:text-lg leading-relaxed font-light mb-5"
                data-i18n-es={project.descEs}
                data-i18n-en={project.descEn}
              >
                {project.descEs}
              </p>
              <div class="flex items-center gap-3">
                <a 
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="repo-link inline-flex items-center justify-center w-10 h-10 rounded-full border border-text-primary/20 dark:border-text-dark/20 hover:bg-text-primary hover:text-bg-primary dark:hover:bg-text-dark dark:hover:text-bg-dark transition-all duration-300"
                  aria-label="Ver repositorio"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
                <button 
                  class="demo-mobile-btn md:hidden inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-text-primary/20 dark:border-text-dark/20 text-sm font-semibold hover:bg-text-primary hover:text-bg-primary dark:hover:bg-text-dark dark:hover:text-bg-dark transition-all duration-300 cursor-pointer"
                  data-video={project.video}
                  aria-label="Ver demo"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                  Ver demo
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
    <!-- Education Section -->
    <section id="education" class="py-20 scroll-mt-24">
      <div class="reveal-item max-w-3xl mx-auto mb-12 text-center">
        <h2 
          class="text-3xl md:text-4xl font-extrabold mb-4 tracking-tight text-text-primary dark:text-text-dark"
          data-i18n="education.title"
        >
          Educación
        </h2>
      </div>
      <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center">
        <div class="w-full md:w-1/3 aspect-4/3 rounded-2xl flex items-center justify-center overflow-hidden p-6">
          <img 
            src="/logo-utn.png" 
            alt="UTN" 
            class="w-full h-full object-contain dark:invert"
            loading="lazy"
          />
        </div>
        <div class="w-full md:w-2/3 text-center md:text-left">
          <h3 
            class="text-xl md:text-2xl font-bold text-text-primary dark:text-text-dark mb-1"
            data-i18n="education.degree"
          >
            Técnico universitario en programación
          </h3>
          <p 
            class="text-base md:text-lg font-medium text-text-primary/70 dark:text-text-dark/70 mb-1"
            data-i18n="education.university"
          >
            Universidad Nacional de La Plata
          </p>
          <p 
            class="text-text-primary/60 dark:text-text-dark/60 text-base font-light"
            data-i18n="education.date"
          >
            feb 2022 - dic 2025
          </p>
        </div>
      </div>
    </section>

    <!-- Tecnologías Section -->
    <section id="tecnologias" class="py-20 border-t border-text-primary/5 dark:border-text-dark/5 scroll-mt-24">
      <div class="reveal-item max-w-3xl mx-auto mb-12 text-center">
        <h2 
          class="text-3xl md:text-4xl font-extrabold mb-4 tracking-tight text-text-primary dark:text-text-dark"
          data-i18n="tech.title"
        >
          Tecnologías
        </h2>
      </div>
      <div id="tech-waves" class="tech-waves-container">
        {technologies.map((tech, index) => (
          <span class="tech-item" title={tech.name}>
            <span 
              class="tech-circle" 
              style={`animation-delay: ${index * 0.1}s${tech.color ? `; background-color: ${tech.color}` : ''}`}
              data-filled={tech.color ? 'true' : undefined}
            >
              <img src={tech.logo} alt={tech.name} loading="lazy" />
            </span>
            <span class="tech-label">{tech.name}</span>
          </span>
        ))}
      </div>
    </section>


    <!-- Contact Section -->
    <section id="contact" class="py-20 border-t border-text-primary/5 dark:border-text-dark/5 scroll-mt-24 mb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Text info -->
        <div class="reveal-item">
          <h2 
            class="text-3xl md:text-4xl font-extrabold mb-4 tracking-tight text-text-primary dark:text-text-dark"
            data-i18n="contact.title"
          >
            Contacto
          </h2>
          <p 
            class="text-text-primary/70 dark:text-text-dark/70 text-lg leading-relaxed mb-8 font-light"
            data-i18n="contact.desc"
          >
            ¿Tienes un proyecto en mente o quieres conversar? Siéntete libre de escribirme y te responderé lo antes posible.
          </p>

          <div class="flex flex-col gap-4">
            <h3 class="text-xs uppercase tracking-wider font-bold opacity-60" data-i18n="contact.info">Información de Contacto</h3>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="opacity-75"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <a href="mailto:lorenzoaletto28@gmail.com?subject=Contacto%20desde%20portafolio&body=Hola%20Lorenzo%2C%20vi%20tu%20portafolio%20y%20quiero%20conversar%20contigo." class="hover:underline font-medium">lorenzoaletto28@gmail.com</a>
            </div>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="opacity-75"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><line x1="12" x2="12" y1="18" y2="18"/></svg>
              <span class="font-medium">+54 9 223 527-9782</span>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="bg-white/40 dark:bg-white/5 backdrop-blur-sm border border-text-primary/10 dark:border-text-dark/10 rounded-2xl p-6 md:p-8">
          <form id="contact-form" class="flex flex-col gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="form-name" class="text-sm font-semibold opacity-80" data-i18n="contact.form.name">Nombre</label>
              <input 
                type="text" 
                id="form-name"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-text-primary/10 dark:border-text-dark/10 bg-white/20 dark:bg-black/20 focus:outline-none focus:ring-2 focus:ring-text-primary/25 dark:focus:ring-text-dark/25 transition-all text-sm"
              />
            </div>
            
            <div class="flex flex-col gap-1.5">
              <label for="form-email" class="text-sm font-semibold opacity-80" data-i18n="contact.form.email">Correo</label>
              <input 
                type="email" 
                id="form-email"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-text-primary/10 dark:border-text-dark/10 bg-white/20 dark:bg-black/20 focus:outline-none focus:ring-2 focus:ring-text-primary/25 dark:focus:ring-text-dark/25 transition-all text-sm"
              />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="form-message" class="text-sm font-semibold opacity-80" data-i18n="contact.form.message">Mensaje</label>
              <textarea 
                id="form-message"
                rows="4"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-text-primary/10 dark:border-text-dark/10 bg-white/20 dark:bg-black/20 focus:outline-none focus:ring-2 focus:ring-text-primary/25 dark:focus:ring-text-dark/25 transition-all text-sm resize-none"
              ></textarea>
            </div>

            <button 
              id="submit-btn"
              type="submit"
              class="btn-submit w-full mt-2 font-bold text-sm py-3 px-6 rounded-xl shadow-md cursor-pointer"
            >
              <span class="btn-text" data-i18n="contact.form.send">Enviar Mensaje</span>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- Cursor-following tooltip -->
  <div id="demo-tooltip" class="cursor-label">watch demo</div>

  <!-- Video Demo Modal -->
  <div 
    id="video-modal" 
    class="fixed inset-0 z-100 flex items-center justify-center bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <div class="relative w-full max-w-4xl mx-4 bg-black rounded-2xl overflow-hidden shadow-2xl">
      <button 
        id="video-modal-close"
        class="absolute top-3 right-3 z-10 w-10 h-10 rounded-full bg-black/50 flex items-center justify-center text-white hover:bg-black/70 transition-colors cursor-pointer"
        aria-label="Cerrar video"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
      </button>
      <video id="video-modal-player" class="w-full aspect-video" controls autoplay></video>
    </div>
  </div>

  <!-- Footer -->
  <footer class="w-full py-8 text-center text-xs opacity-50 border-t border-text-primary/5 dark:border-text-dark/5">
    <p>&copy; {new Date().getFullYear()} Lorenzo Aletto. All rights reserved.</p>
  </footer>
</Layout>

<script>
  // --- Fade-in reveal on scroll ---
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.reveal-item').forEach(el => observer.observe(el));

  // --- Video Modal ---
  const videoWrappers = document.querySelectorAll('.project-image-wrapper');
  const videoModal = document.getElementById('video-modal')!;
  const videoPlayer = document.getElementById('video-modal-player') as HTMLVideoElement;
  const videoClose = document.getElementById('video-modal-close')!;

  videoWrappers.forEach(wrapper => {
    wrapper.addEventListener('click', () => {
      const src = wrapper.getAttribute('data-video');
      if (src) {
        videoPlayer.src = src;
        videoModal.classList.remove('opacity-0', 'pointer-events-none');
        videoModal.classList.add('opacity-100', 'pointer-events-auto');
      }
    });
  });

  // --- Mobile demo buttons ---
  document.querySelectorAll('.demo-mobile-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-video');
      if (src) {
        videoPlayer.src = src;
        videoModal.classList.remove('opacity-0', 'pointer-events-none');
        videoModal.classList.add('opacity-100', 'pointer-events-auto');
      }
    });
  });

  function closeVideoModal() {
    videoModal.classList.remove('opacity-100', 'pointer-events-auto');
    videoModal.classList.add('opacity-0', 'pointer-events-none');
    videoPlayer.pause();
    videoPlayer.src = '';
  }

  videoClose.addEventListener('click', closeVideoModal);
  videoModal.addEventListener('click', (e) => {
    if (e.target === videoModal) closeVideoModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeVideoModal();
  });

  // --- Contact Form (EmailJS) ---
  import emailjs from '@emailjs/browser';

  
  const EMAILJS_SERVICE_ID = 'service_7zhnpso';   // Service ID de tu servicio de email
  const EMAILJS_TEMPLATE_ID = 'template_66n8mce';  // Template ID de tu plantilla
  const EMAILJS_PUBLIC_KEY  = 'dzjlgh1wCiyHawiz7';     // Public Key de tu cuenta

  const contactForm = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn')!;
  const btnText = submitBtn.querySelector('.btn-text')!;

  contactForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name    = (document.getElementById('form-name') as HTMLInputElement).value;
    const email   = (document.getElementById('form-email') as HTMLInputElement).value;
    const message = (document.getElementById('form-message') as HTMLTextAreaElement).value;

    submitBtn.classList.add('sending');

    try {
      await emailjs.send(
        EMAILJS_SERVICE_ID,
        EMAILJS_TEMPLATE_ID,
        { name, email, message },
        EMAILJS_PUBLIC_KEY,
      );

      btnText.textContent = '✓';
    } catch {
      btnText.textContent = '✗ Error';
    }

    setTimeout(() => {
      contactForm.reset();
      submitBtn.classList.remove('sending');
      btnText.textContent = 'Enviar Mensaje';
    }, 2500);
  });

  // --- "Ver demo" cursor-following tooltip ---
  const tooltip = document.getElementById('demo-tooltip')!;

  videoWrappers.forEach(wrapper => {
    wrapper.addEventListener('mouseenter', () => { tooltip.style.opacity = '1'; });
    wrapper.addEventListener('mouseleave', () => { tooltip.style.opacity = '0'; });
    wrapper.addEventListener('mousemove', (e) => {
      const x = e.clientX + 16;
      const y = e.clientY + 16;
      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
    });
  });
</script>
